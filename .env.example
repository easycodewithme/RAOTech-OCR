# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# PostgreSQL Database (Prisma) — Supabase/Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# FastAPI Backend URL (OCR Python server on Render)
BACKEND_URL=https://your-backend.onrender.com

# Shared secret for the OCR backend, sent as X-API-Key by the server routes.
# Must match BACKEND_API_KEY in the OCR-invoice service. Server-side only —
# never prefix this with NEXT_PUBLIC_.
BACKEND_API_KEY=

# Demo booking (Google OAuth; authorize the calendar owner once)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=
DEMO_EMPLOYEE_EMAIL=employee@example.com
