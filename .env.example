# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# PostgreSQL Database (Prisma) — Supabase/Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Brevo (transactional email) — used to send enterprise team-invitation emails.
# BREVO_SENDER_EMAIL must be a verified sender/domain in the Brevo dashboard.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=RAO AI

# Public base URL of this app, used to build links (e.g. invite-accept links)
# sent inside emails. Use http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI Backend URL (OCR Python server on Render)
BACKEND_URL=https://your-backend.onrender.com

# Shared secret for the OCR backend, sent as X-API-Key by the server routes.
# Must match BACKEND_API_KEY in the OCR-invoice service. Server-side only —
# never prefix this with NEXT_PUBLIC_.
BACKEND_API_KEY=

# Demo booking (Calendly handles scheduling, Google Meet, and email invitations)
NEXT_PUBLIC_CALENDLY_BOOKING_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
